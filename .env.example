# Server Configuration
PORT=5100
NODE_ENV=production

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=krphysio_user
DB_PASSWORD=replace_with_your_db_password
DB_NAME=krphysiotherapy

# Admin Credentials for /admin (REQUIRED — login returns 503 while unset)
ADMIN_EMAIL=admin@krphysiotherapy.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Admin session-token signing key (HMAC-SHA256, required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=replace_with_a_random_48_byte_secret
